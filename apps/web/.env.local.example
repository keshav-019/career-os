# Cloudflare R2 (learning content + images). See apps/web/src/lib/r2/client.ts.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET_NAME=
# Public R2.dev URL for the bucket above (bucket must have R2.dev public access enabled) - used to serve
# learning/interview images directly to the browser without a signed URL. See lib/learning/asset-url.ts.
R2_PUBLIC_BASE_URL=
# Same value as R2_PUBLIC_BASE_URL, NEXT_PUBLIC_-prefixed so it also survives into client-side bundles
# (learningAssetUrl() is called from "use client" pages too). Not a secret - same public bucket URL.
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=
