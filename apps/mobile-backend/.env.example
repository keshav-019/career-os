PORT=8080

# Firebase Admin SDK (required) - same project as apps/web. Generate a service account key from
# Firebase Console -> Project Settings -> Service Accounts -> Generate new private key, then copy the three
# fields below. FIREBASE_PRIVATE_KEY must keep its literal \n escape sequences when pasted into Railway's env var
# editor (Railway stores it as a single-line string; this app un-escapes it at startup, same as apps/web).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Used as a fallback identity lookup when verifying a request's Firebase ID token.
FIREBASE_API_KEY=

# OpenRouter (required only for the /api/ai/* routes - job match, resume review, resume generation, learning plan)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_SITE_URL=https://careeros.app
OPENROUTER_APP_NAME=CareerOS

# GitHub sign-in for the mobile app's "Continue with GitHub" button (required only for that - email/password and
# Google sign-in both work without it; Google uses its own native Android OAuth client entirely client-side, no
# server involved). This is the dedicated GitHub OAuth App created for the mobile app (GitHub has no
# native/public client type, so this secret is unavoidable). You also need to add
# https://<this-service's-Railway-URL>/api/oauth/github/callback as an authorized callback URL on that GitHub
# OAuth App - see apps/mobile-backend/src/routes/oauth.ts's file comment.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
