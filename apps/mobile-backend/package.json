{
  "name": "@careeros/mobile-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone Node/Express backend for the CareerOS Android app - reuses apps/web/src/lib directly (no duplicated business logic). Exists because Vercel's serverless bundling of firebase-admin breaks these routes in production; this runs as a normal long-lived Node process instead (Docker on vanisher.projectyourown.com, or any plain Node host).",
  "main": "src/server.ts",
  "scripts": {
    "start": "tsx -r ../../scripts/register-env.cjs src/server.ts",
    "dev": "tsx watch -r ../../scripts/register-env.cjs src/server.ts",
    "build": "esbuild src/server.ts --tsconfig=tsconfig.json --bundle --platform=node --target=node22 --packages=external --sourcemap --outfile=dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1091.0",
    "@aws-sdk/s3-request-presigner": "^3.1091.0",
    "@careeros/shared": "file:../../packages/shared",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "firebase-admin": "^13.10.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "latest",
    "esbuild": "^0.28.1",
    "tsx": "^4.19.2",
    "typescript": "latest"
  },
  "engines": {
    "node": "22.x"
  }
}
