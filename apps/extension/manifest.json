{
  "manifest_version": 3,
  "name": "CareerOS Capture",
  "description": "Save job posts into CareerOS.",
  "version": "0.1.0",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Save to CareerOS"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "js": [
        "src/contentScript.js"
      ]
    }
  ]
}
