{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "node -v && npm -v && npm ci --workspace @careeros/web --workspace @careeros/shared --no-audit --no-fund",
  "buildCommand": "node -v && npm -v && npm run build --workspace @careeros/web",
  "devCommand": "npm run dev --workspace @careeros/web",
  "outputDirectory": "apps/web/.next"
}