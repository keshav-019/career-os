rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // Reads the caller's own admin flag directly from Firestore, independent of whether the Admin SDK is
    // configured server-side (see lib/server/require-admin.ts's fallback path, which can fail open in a way
    // this cannot - `admin` on users/{uid} can only ever be set via the Firebase console or Admin SDK, both of
    // which bypass these rules entirely, so this get() is exactly as trustworthy as the field itself).
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('admin', false) == true;
    }

    // The root users/{userId} document carries account-level flags such as
    // `admin`. Clients may read and update their own document, but they can
    // never introduce or change the `admin` field themselves - it can only be
    // set through the Firebase console or the Admin SDK, both of which bypass
    // these rules entirely. This is what makes the "admin" gate trustworthy.
    // `non_admin` has no such restriction - it's meant to be hand-set/removed
    // via the Firebase console as a temporary local dev toggle (see above).
    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() && request.auth.uid == userId
        && request.resource.data.get('admin', false) == false;

      allow update: if isSignedIn() && request.auth.uid == userId
        && request.resource.data.get('admin', false) == resource.data.get('admin', false);
    }

    match /users/{userId}/{document=**} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Coding-arena problems. The admin editor UI (app/admin/coding-problems) and the server-side requireAdmin()
    // check gate the save API route, but those routes persist via a plain authenticated Firestore REST write
    // (see lib/firebase/admin.ts's fallback for when the Admin SDK isn't configured) - so these rules are the
    // REAL enforcement layer, not a fallback. Write is admin-only: a coding problem's `harness` field is
    // executed verbatim by every other user's desktop app when they open the problem (see
    // apps/desktop/src/coding/index.js's composeFullSource), so any signed-in writer here would be a
    // cross-user remote-code-execution vector, not just catalog vandalism. Read stays open to any signed-in
    // user since the catalog itself is meant to be public within the app.
    match /codingProblems/{problemId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Mirrors codingProblems above, for the system-design catalog's admin editor.
    match /systemDesignProblems/{problemId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Mirrors codingProblems above, for the aptitude/computer-science/AI technical test-paper admin editor
    // (app/admin/test-papers). Read access is needed by any signed-in user, not just admins, since these are
    // merged into the public /api/interview/templates* results that both web and mobile fetch to take a test.
    // Write is admin-only so an ordinary user can't rewrite the answer key (correctOptionId) other users are
    // scored against.
    match /customTestPapers/{paperId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Admin-authored Learning Center categories (app/admin/learning-content). Mirrors codingProblems above -
    // read access is needed by any signed-in user since these are merged into the public /api/learning/library
    // and /api/learning/topic results both apps fetch. Write is admin-only.
    match /learningCategories/{categoryId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Submission/attempt logs are append-only, per-user event logs (no
    // solution content). Users can read and write only their own log
    // entries; nothing here is ever editable after creation from the client.
    match /codingSubmissionLogs/{logId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /systemDesignAttemptLogs/{logId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
