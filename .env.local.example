# CareerOS single local env file
#
# Copy this file to .env.local at the repo root. All workspace scripts load this root file first.
# Production deploys should use the hosting provider's environment-variable dashboard with the same keys.

# App origins
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CAREEROS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CAREEROS_ALLOWED_EXTENSION_IDS=

# Firebase client config (public identifiers)
FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin SDK (server-only)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Cloudflare R2 profile/resume files
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=

# Cloudinary browser uploads
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Career intelligence / AI
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=CareerOS
OPENROUTER_MODEL=openrouter/free
OPENROUTER_SITE_URL=http://localhost:3000
CAREEROS_AI_MODEL=
CAREEROS_AI_TIMEOUT_MS=

# Web OAuth and extension auth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
FIREFOX_EXTENSION_ID=capture@careeros.app

# Desktop app
CAREEROS_DESKTOP_APP=
NEXT_PUBLIC_CAREEROS_DESKTOP_APP=
CAREEROS_DESKTOP_BUILD=
CAREEROS_DESKTOP_WEB_URL=
NEXT_PUBLIC_DESKTOP_HELPER_URL=http://127.0.0.1:43823
GOOGLE_DESKTOP_OAUTH_CLIENT_SECRET=
CAREEROS_DISABLE_PORTABLE_LATEX=
CAREEROS_GITHUB_REPO=keshav-019/career-os
NEXT_PUBLIC_CAREEROS_GITHUB_REPO=keshav-019/career-os

# Mobile / Expo public config
EXPO_PUBLIC_CAREEROS_API_BASE_URL=https://careerosbackend.projectyourown.com
EXPO_PUBLIC_CAREEROS_LEGACY_WEB_BASE_URL=https://keshav-019-career-os.vercel.app
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=
EXPO_PUBLIC_R2_PUBLIC_BASE_URL=
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Email, support, and webhooks
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=CareerOS <no-reply@projectyourown.com>
HELP_NOTIFICATION_EMAIL=

# 2FA / learning admin
TWO_FACTOR_ENCRYPTION_KEY=
TOTP_APP_IMAGE_URL=
NEXT_PUBLIC_TOTP_APP_IMAGE_URL=
ALLOW_LEARNING_CONTENT_EDIT=
CAREEROS_LEARNING_ADMIN_USERNAME=admin
CAREEROS_LEARNING_ADMIN_PASSWORD=
CAREEROS_LEARNING_ADMIN_SESSION_SECRET=
LEARNING_PUBLIC_DIR=

# Local servers and tests
PORT=8080
E2E_BASE_URL=
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=
